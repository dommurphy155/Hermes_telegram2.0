# Copy to home/.env and fill in. Never commit the real .env.
# The bot token from @BotFather. If it has ever been pasted into a chat or an
# issue, /revoke it in BotFather and put the new one here.
TELEGRAM_BOT_TOKEN=

# Only these users may drive the bot. Comma-separated numeric ids.
TELEGRAM_ALLOWED_USERS=

# Where cron/notification output goes. Usually the same as your user id.
TELEGRAM_HOME_CHANNEL=